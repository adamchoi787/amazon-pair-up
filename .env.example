# Copy to .env and fill in. Everything has a working default for local dev.

# --- Server ---
PORT=3000
# 127.0.0.1 for local dev. Use 0.0.0.0 when deployed behind a load balancer.
HOST=127.0.0.1
# Comma-separated public hostnames allowed in the Host header when HOST=0.0.0.0
# (DNS-rebinding protection), e.g. mcp.example.com
ALLOWED_HOSTS=
# Browser origins allowed to call /mcp (e.g. a web simulator). Requests with any other
# Origin header get 403. Server-to-server callers like Alexa+ send no Origin.
ALLOWED_ORIGINS=
# Optional shared secret. When set, /mcp requires "Authorization: Bearer <key>".
MCP_API_KEY=

# --- Auth (Alexa+ account linking) ---
# none  = identity from the X-User-Id header or a user_id argument (local dev, tests)
# oauth = OAuth 2.1 authorization code + PKCE; /mcp requires a Bearer token (Alexa+)
AUTH_MODE=none
# Public https origin of this server, e.g. https://amazon-pairup.xxxx.amazonlightsail.com
PUBLIC_BASE_URL=
# The client Alexa uses. Register the same values with `alexa-ai configure-account-linking`.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Comma-separated Alexa redirect URIs from the Developer Hub (exact match).
OAUTH_REDIRECT_URIS=
# Sign-in: Login with Amazon. Create a security profile at
# https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html and add
# <PUBLIC_BASE_URL>/oauth/amazon/callback as an allowed return URL. The user id is the
# Amazon account's user_id; other people see the profile's first name.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
# true = also offer the name + passcode sign-in, labelled "Demo sign-in for judges".
# The first sign-in with a name sets its passcode. Always on when PUBLIC_BASE_URL is
# http://localhost or 127.0.0.1. A public server needs LWA_* or DEMO_MODE=true to start.
DEMO_MODE=false
# Optional access code every demo sign-in must also enter.
DEMO_LOGIN_PASSCODE=
# MCP clients that aren't pre-registered connect with a Client ID Metadata Document
# (their client_id is an https URL) or register at /oauth/register (RFC 7591).
# Registrations allowed per IP per hour; 0 turns /oauth/register off.
DCR_PER_HOUR=20

# --- Database ---
# Empty = embedded Postgres + pgvector (PGlite) stored in ./.data/pglite.
# Set to a real Postgres URL (RDS / Aurora / Neon / Supabase with pgvector) for deployment.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# true = load data/seed-listings.json on startup when the listings table is empty
SEED_ON_START=false

# --- AI ---
# "mock"    = no AWS needed; deterministic local embeddings + rule-based intent parsing.
# "bedrock" = Amazon Bedrock (Titan embeddings + an LLM for intent extraction).
AI_MODE=mock
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Pick a model/inference profile you have access to in the Bedrock console.
BEDROCK_INTENT_MODEL_ID=
# The web app's assistant (Converse tool use). Defaults to BEDROCK_INTENT_MODEL_ID.
# A fast model with tool use keeps voice replies snappy.
BEDROCK_AGENT_MODEL_ID=
EMBEDDING_DIM=1024
# Minimum relevance (semantic + keyword, 0..1) for two posts to count as a match.
# Price and meet-up area only rank posts that pass it.
MATCH_THRESHOLD=0.35

# --- Marketplace policy ---
# How long a proposed deal holds both posts before it expires and both are paired again.
# A request's deadline ends the hold sooner (a lunch run expires by lunchtime).
DEAL_HOLD_HOURS=24
# The market's time zone: spoken times ("by 12:30", "Saturday 2-6pm") are read and said in it.
TZ=Asia/Hong_Kong
# Posts (offers + requests) one user can create per hour.
POSTS_PER_HOUR=30
# Open requests one user can have at a time.
MAX_OPEN_REQUESTS=10
# MCP calls per caller per minute (per server process). 0 turns the limit off.
MCP_CALLS_PER_MINUTE=120

# --- Behind a CDN ---
# When set, every request except /health must carry X-Origin-Verify: <value>.
# CloudFront adds the header (deploy/aws), so the origin can't be reached directly.
ORIGIN_SECRET=

# --- Dashboard ---
# /api/dashboard shows every post and deal (never private limits). It is open when
# AUTH_MODE=none; otherwise set a long random token and open the page as /#token=<token>.
DASHBOARD_TOKEN=
