# Copy to .env and fill in. Everything has a working default for local dev.

# --- Server ---
PORT=3000
# 127.0.0.1 for local dev. Use 0.0.0.0 when deployed behind a load balancer.
HOST=127.0.0.1
# Comma-separated public hostnames allowed in the Host header when HOST=0.0.0.0
# (DNS-rebinding protection), e.g. mcp.example.com
ALLOWED_HOSTS=
# Browser origins allowed to call /mcp (e.g. a web simulator). Requests with any other
# Origin header get 403. Server-to-server callers like Alexa+ send no Origin.
ALLOWED_ORIGINS=
# Optional shared secret. When set, /mcp requires "Authorization: Bearer <key>".
MCP_API_KEY=

# --- Auth (Alexa+ account linking) ---
# none  = identity from the X-User-Id header or a user_id argument (local dev, tests)
# oauth = OAuth 2.1 authorization code + PKCE; /mcp requires a Bearer token (Alexa+)
AUTH_MODE=none
# Public https origin of this server, e.g. https://voice-market.xxxx.amazonlightsail.com
PUBLIC_BASE_URL=
# The client Alexa uses. Register the same values with `alexa-ai configure-account-linking`.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Comma-separated Alexa redirect URIs from the Developer Hub (exact match).
OAUTH_REDIRECT_URIS=
# Optional passcode required on the demo sign-in page.
DEMO_LOGIN_PASSCODE=

# --- Database ---
# Empty = embedded Postgres + pgvector (PGlite) stored in ./.data/pglite.
# Set to a real Postgres URL (RDS / Aurora / Neon / Supabase with pgvector) for deployment.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# true = load data/seed-listings.json on startup when the listings table is empty
SEED_ON_START=false

# --- AI ---
# "mock"    = no AWS needed; deterministic local embeddings + rule-based intent parsing.
# "bedrock" = Amazon Bedrock (Titan embeddings + an LLM for intent extraction).
AI_MODE=mock
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Pick a model/inference profile you have access to in the Bedrock console.
BEDROCK_INTENT_MODEL_ID=
EMBEDDING_DIM=1024
# Minimum relevance (semantic + keyword, 0..1) for two posts to count as a match.
# Price and meet-up area only rank posts that pass it.
MATCH_THRESHOLD=0.35
