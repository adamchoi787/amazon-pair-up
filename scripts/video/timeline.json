 "lines": [
  {
   "id": "n01",
   "who": "narrator",
   "at": 0.5,
   "until": 3.4,
   "text": "It's eleven forty-seven at night. Your exam is at nine."
  },
  {
   "id": "n02",
   "who": "narrator",
   "at": 3.5,
   "until": 6.4,
   "text": "And somewhere in the next dorm, the calculator you need is sitting in a drawer."
  },
  {
   "id": "n03",
   "who": "narrator",
   "at": 6.5,
   "until": 7.9,
   "text": "What if you could just... say it?"
  },
  {
   "id": "n04",
   "who": "narrator",
   "at": 10.02,
   "until": 10.5,
   "text": "Meet PairUp!"
  },
  {
   "id": "n05",
   "who": "narrator",
   "at": 12.25,
   "until": 17.1,
   "text": "PairUp pairs people who need something with people who have it, or can help. Things and services, right here at UW in Seattle."
  },
  {
   "id": "n06",
   "who": "narrator",
   "at": 17.25,
   "until": 19.9,
   "text": "Tell Alexa+ once, and PairUp finds your pair."
  },
  {
   "id": "sam1",
   "who": "sam",
   "at": 20.25,
   "until": 23.3,
   "text": "Sell my TI-84 for twenty dollars. I'll take anything above fifteen."
  },
  {
   "id": "n07",
   "who": "narrator",
   "at": 23.45,
   "until": 25.95,
   "text": "Sam sets his limit once, and it stays private."
  },
  {
   "id": "mei1",
   "who": "mei",
   "at": 26.1,
   "until": 29.5,
   "text": "I need a graphing calculator in good condition near UW campus today. Max eighteen."
  },
  {
   "id": "n08",
   "who": "narrator",
   "at": 29.6,
   "until": 33.95,
   "text": "Paired, instantly! Our open price rule settles it at eighteen dollars, with a meeting spot right on campus."
  },
  {
   "id": "mei2",
   "who": "mei",
   "at": 34.0,
   "until": 34.3,
   "text": "Yes!"
  },
  {
   "id": "n10",
   "who": "narrator",
   "at": 37.0,
   "until": 37.95,
   "text": "They pay each other at the hand-off."
  },
  {
   "id": "n11",
   "who": "narrator",
   "at": 38.25,
   "until": 42.1,
   "text": "Meeting a stranger? Pick a PairUp Point: one Ring doorbell by the HUB. No staff needed."
  },
  {
   "id": "n12",
   "who": "narrator",
   "at": 42.2,
   "until": 44.98,
   "text": "Each press confirms an arrival, and PairUp keeps only its type and time."
  },
  {
   "id": "pu1",
   "who": "pairup",
   "at": 45.8,
   "until": 47.7,
   "text": "Both here. Go ahead with the hand-off."
  },
  {
   "id": "n13",
   "who": "narrator",
   "at": 48.25,
   "until": 49.4,
   "text": "And it books people, too!"
  },
  {
   "id": "tony1",
   "who": "tony",
   "at": 49.4,
   "until": 52.68,
   "text": "Find someone to pick up my lunch from the HUB to McCarty Hall by twelve thirty. Five dollars."
  },
  {
   "id": "n14",
   "who": "narrator",
   "at": 52.75,
   "until": 56.1,
   "text": "Event help on Saturday, two to six? Ten dollars an hour, forty total, in Pacific time."
  },
  {
   "id": "n15",
   "who": "narrator",
   "at": 56.25,
   "until": 59.9,
   "text": "The whole shift has to fit the helper's hours, bookings never overlap, and the helper gives the final yes."
  },
  {
   "id": "n16",
   "who": "narrator",
   "at": 60.25,
   "until": 64.1,
   "text": "PairUp even learns your routine. Three weeks of lunch runs? It offers the next one before noon."
  },
  {
   "id": "n17",
   "who": "narrator",
   "at": 64.25,
   "until": 67.9,
   "text": "A Bee note about tomorrow's exam becomes a ready request, waiting for your yes, right on your wrist."
  },
  {
   "id": "n18",
   "who": "narrator",
   "at": 68.3,
   "until": 71.8,
   "text": "Under the hood: a production MCP server for Alexa+ and any agent."
  },
  {
   "id": "n19",
   "who": "narrator",
   "at": 71.72,
   "until": 75.65,
   "text": "Amazon Bedrock understands people: Nova reads each request, and Titan embeddings power the search."
  },
  {
   "id": "n20",
   "who": "narrator",
   "at": 75.75,
   "until": 79.95,
   "text": "Then code takes over: a Rust price rule, compiled to WebAssembly, settles every deal in exact cents."
  },
  {
   "id": "n21",
   "who": "narrator",
   "at": 80.5,
   "until": 83.4,
   "text": "Live on AWS. A hundred seventy-five tests, all green."
  },
  {
   "id": "n22",
   "who": "narrator",
   "at": 84.25,
   "until": 87.6,
   "text": "Resale sites keep up to twenty percent. On PairUp, the seller keeps every dollar."
  },
  {
   "id": "n23",
   "who": "narrator",
   "at": 87.62,
   "until": 91.5,
   "text": "Seventy-three million Americans already earn on their own. Here, opening a business takes one sentence."
  },
  {
   "id": "n24",
   "who": "narrator",
   "at": 91.6,
   "until": 95.9,
   "text": "Soon, agents will shop for us. PairUp gives them a fair place to meet, where a human always says yes."
  },
  {
   "id": "n25",
   "who": "narrator",
   "at": 96.25,
   "until": 100.3,
   "text": "The price rule is open source, so anyone can check it. Next stop: a real pilot, right here at UW."
  },
  {
   "id": "n26",
   "who": "narrator",
   "at": 99.53,
   "until": 100.0,
   "text": "PairUp."
  },
  {
   "id": "n27",
   "who": "narrator",
   "at": 104.4,
   "until": 104.99,
   "text": "Say it once!"
  }
 ],
