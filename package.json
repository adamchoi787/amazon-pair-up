{
  "name": "amazon-pairup",
  "version": "0.1.0",
  "description": "Voice-first C2C marketplace for Alexa+: an MCP server that pairs buyers and sellers of things and services from natural-language requests and negotiates the deal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/seed.ts --reset",
    "smoke": "tsx scripts/smoke.ts",
    "learn": "tsx scripts/learn.ts",
    "simulate": "tsx scripts/simulate-learning.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "pairing-core": "file:vendor/pairing-core",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
