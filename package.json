{
  "name": "voice-market-mcp",
  "version": "0.1.0",
  "description": "Voice-first C2C marketplace for Alexa+: an MCP server that pairs buyers and sellers from natural-language requests and negotiates the deal.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/seed.ts --reset",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
